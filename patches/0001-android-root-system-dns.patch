--- /dev/null
+++ b/component/systemdns/build.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Build the embedded Android network observer with JDK 17+ and Android SDK 36."""
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+
+def main():
+    root = Path(__file__).resolve().parent
+    sdk = Path(os.environ["ANDROID_HOME"])
+    android_jar = sdk / "platforms/android-36/android.jar"
+    d8 = sdk / "build-tools/36.0.0/lib/d8.jar"
+    for path in (android_jar, d8):
+        if not path.is_file():
+            raise FileNotFoundError(f"Missing Android SDK component: {path}")
+
+    def java_tool(name):
+        suffix = ".exe" if os.name == "nt" else ""
+        return str(Path(os.environ["JAVA_HOME"]) / "bin" / (name + suffix)) if os.environ.get("JAVA_HOME") else name + suffix
+
+    with tempfile.TemporaryDirectory(prefix="mihomo-system-dns-") as tmp:
+        classes, dex = Path(tmp) / "classes", Path(tmp) / "dex"
+        classes.mkdir()
+        dex.mkdir()
+        subprocess.run([java_tool("javac"), "--release", "8", "-classpath", str(android_jar),
+                        "-d", str(classes), str(root / "java/SystemDnsHelper.java")], check=True)
+        subprocess.run([java_tool("java"), "-cp", str(d8), "com.android.tools.r8.D8", "--release",
+                        "--min-api", "26", "--lib", str(android_jar), "--output", str(dex),
+                        *map(str, sorted(classes.rglob("*.class")))], check=True)
+        if sorted(p.name for p in dex.iterdir()) != ["classes.dex"]:
+            raise RuntimeError("System DNS helper must fit in one dex")
+        shutil.copyfile(dex / "classes.dex", root / "helper.dex")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/component/systemdns/client.go b/component/systemdns/client.go
new file mode 100644
index 0000000000000000000000000000000000000000..17de933b47fae53a79530b7402c20c80ad347b72
--- /dev/null
+++ b/component/systemdns/client.go
@@ -0,0 +1,101 @@
+//go:build linux
+
+package systemdns
+
+import (
+	"bufio"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"runtime"
+	"sync"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func start(cmd *exec.Cmd, update func([]string), failed func(error)) (func(), error) {
+	pair, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("system DNS socketpair: %w", err)
+	}
+	parent := os.NewFile(uintptr(pair[0]), "system-dns-parent")
+	child := os.NewFile(uintptr(pair[1]), "system-dns-child")
+	defer child.Close()
+	connection, err := net.FileConn(parent)
+	_ = parent.Close()
+	if err != nil {
+		return nil, err
+	}
+	// stdin watches the parent's lifetime; fd 3 carries snapshots back to it.
+	cmd.Stdin = child
+	cmd.ExtraFiles = []*os.File{child}
+	cmd.Stderr = os.Stderr
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true, Pdeathsig: syscall.SIGKILL}
+	started, done := make(chan error, 1), make(chan error, 1)
+	go func() {
+		// PDEATHSIG follows the creating OS thread, which Go may otherwise retire.
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		err := cmd.Start()
+		started <- err
+		if err == nil {
+			done <- cmd.Wait()
+		}
+	}()
+	if err = <-started; err != nil {
+		_ = connection.Close()
+		return nil, fmt.Errorf("start system DNS helper: %w", err)
+	}
+	_ = child.Close()
+	stopping := make(chan struct{})
+	var once sync.Once
+	stop := func() {
+		once.Do(func() {
+			close(stopping)
+			_ = connection.Close()
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				_ = cmd.Process.Kill()
+				<-done
+			}
+		})
+	}
+	_ = connection.SetReadDeadline(time.Now().Add(10 * time.Second))
+	reader := bufio.NewReaderSize(connection, MaxFrame)
+	read := func() ([]string, error) {
+		frame, err := reader.ReadSlice('\n')
+		if err != nil {
+			return nil, err
+		}
+		return decodeSnapshot(frame)
+	}
+	servers, err := read()
+	if err != nil {
+		stop()
+		return nil, fmt.Errorf("system DNS initial snapshot: %w", err)
+	}
+	update(servers)
+	_ = connection.SetReadDeadline(time.Time{})
+	go func() {
+		for {
+			next, err := read()
+			if err != nil {
+				select {
+				case <-stopping:
+					return
+				default:
+				}
+				update(nil)
+				failed(fmt.Errorf("system DNS channel failed: %w", err))
+				return
+			}
+			// The observer also notifies when the network changes but its DNS does not.
+			update(next)
+		}
+	}()
+	return stop, nil
+}
diff --git a/component/systemdns/client_test.go b/component/systemdns/client_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..62809855964329808e520a7164d41953af1106f1
--- /dev/null
+++ b/component/systemdns/client_test.go
@@ -0,0 +1,130 @@
+//go:build linux
+
+package systemdns
+
+import (
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"reflect"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Run in a subprocess to exercise real inherited descriptors and parent EOF.
+func TestSystemDNSProcess(t *testing.T) {
+	mode, child := strings.CutPrefix(os.Args[len(os.Args)-1], "--system-dns-child=")
+	if !child {
+		return
+	}
+	output := os.NewFile(3, "snapshots")
+	if mode == "bad-start" {
+		fmt.Fprintln(output, `{"version":2,"servers":[]}`)
+		os.Exit(0)
+	}
+	fmt.Fprintln(output, `{"version":1,"servers":["192.0.2.1:53"]}`)
+	switch mode {
+	case "changes":
+		// A new physical network can advertise the same DNS endpoints.
+		fmt.Fprintln(output, `{"version":1,"servers":["192.0.2.1:53"]}`)
+		fmt.Fprintln(output, `{"version":1,"servers":[]}`)
+		fmt.Fprintln(output, `{"version":1,"servers":["[fe80::1%wlan0]:53"]}`)
+	case "disconnect":
+		os.Exit(0)
+	case "invalid":
+		fmt.Fprintln(output, `{"version":1,"servers":["127.0.0.1:53"]}`)
+	case "oversized":
+		fmt.Fprint(output, strings.Repeat(" ", MaxFrame))
+	}
+	_, _ = io.Copy(io.Discard, os.Stdin)
+	os.Exit(0)
+}
+
+func helperCommand(mode string) *exec.Cmd {
+	return exec.Command(os.Args[0], "-test.run=^TestSystemDNSProcess$", "--", "--system-dns-child="+mode)
+}
+
+func TestClientUpdatesAndShutdown(t *testing.T) {
+	updates := make(chan []string, 8)
+	failed := make(chan error, 1)
+	cmd := helperCommand("changes")
+	stop, err := start(cmd, func(servers []string) { updates <- servers }, func(err error) { failed <- err })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	for _, want := range [][]string{{"192.0.2.1:53"}, {"192.0.2.1:53"}, {}, {"[fe80::1%wlan0]:53"}} {
+		select {
+		case got := <-updates:
+			if !reflect.DeepEqual(got, want) {
+				t.Fatalf("snapshot = %v, want %v", got, want)
+			}
+		case <-time.After(5 * time.Second):
+			t.Fatal("missing DNS change")
+		}
+	}
+	stop()
+	stop()
+	if !cmd.ProcessState.Success() {
+		t.Fatalf("helper did not exit on stdin EOF: %v", cmd.ProcessState)
+	}
+	select {
+	case err := <-failed:
+		t.Fatalf("normal shutdown reported failure: %v", err)
+	default:
+	}
+}
+
+func TestClientWithdrawsDNSOnFailure(t *testing.T) {
+	for _, mode := range []string{"disconnect", "invalid", "oversized"} {
+		t.Run(mode, func(t *testing.T) {
+			updates := make(chan []string, 8)
+			failed := make(chan error, 1)
+			stop, err := start(helperCommand(mode), func(servers []string) { updates <- servers }, func(err error) { failed <- err })
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer stop()
+			select {
+			case err := <-failed:
+				if err == nil || len(<-updates) != 1 || <-updates != nil {
+					t.Fatal("helper failure did not withdraw DNS")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("helper failure was not reported")
+			}
+		})
+	}
+}
+
+func TestClientStartupFailure(t *testing.T) {
+	for _, cmd := range []*exec.Cmd{exec.Command("/nonexistent/system-dns-helper"), helperCommand("bad-start")} {
+		_, err := start(cmd, func([]string) { t.Error("invalid initial snapshot was applied") },
+			func(error) { t.Error("startup failure reported as runtime failure") })
+		if err == nil {
+			t.Fatal("startup succeeded")
+		}
+		if cmd.Process != nil && cmd.ProcessState == nil {
+			t.Fatal("failed helper was not reaped")
+		}
+	}
+}
+
+func TestClientKillsUnresponsiveHelper(t *testing.T) {
+	cmd := helperCommand("idle")
+	stop, err := start(cmd, func([]string) {}, func(error) {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	if err := cmd.Process.Signal(syscall.SIGSTOP); err != nil {
+		t.Fatal(err)
+	}
+	stop()
+	if cmd.ProcessState.Sys().(syscall.WaitStatus).Signal() != syscall.SIGKILL {
+		t.Fatal("unresponsive helper was not killed")
+	}
+}
diff --git a/component/systemdns/helper.go b/component/systemdns/helper.go
new file mode 100644
index 0000000000000000000000000000000000000000..49eb47aeaf6714939463b5e94c7aadb256adf6e9
--- /dev/null
+++ b/component/systemdns/helper.go
@@ -0,0 +1,104 @@
+//go:build android || linux
+
+package systemdns
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"syscall"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	helperFilename = "system-dns-helper.dex"
+	tempPattern    = ".system-dns-helper-*.dex"
+)
+
+// A core killed while replacing the dex leaves its temporary behind. Skip
+// recent files in case another process is still writing one.
+func removeStaleTemporaries(home string) {
+	names, _ := filepath.Glob(filepath.Join(home, tempPattern))
+	for _, name := range names {
+		if info, err := os.Lstat(name); err == nil && info.Mode().IsRegular() &&
+			time.Since(info.ModTime()) > time.Minute {
+			_ = os.Remove(name)
+		}
+	}
+}
+
+// Retain the real path and ART's sibling oat cache across process exits.
+// Android 8's class loader cannot open an already unlinked dex through procfs.
+func ensureHelper(home string, payload []byte) (string, error) {
+	home, err := filepath.Abs(home)
+	if err != nil {
+		return "", err
+	}
+	if err = os.MkdirAll(home, 0700); err != nil {
+		return "", err
+	}
+	path := filepath.Join(home, helperFilename)
+	match, err := helperMatches(path, payload)
+	if err != nil || match {
+		return path, err
+	}
+	removeStaleTemporaries(home)
+	file, err := os.CreateTemp(home, tempPattern)
+	if err != nil {
+		return "", err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	if _, err = file.Write(payload); err != nil {
+		return "", err
+	}
+	if err = file.Chmod(0400); err != nil {
+		return "", err
+	}
+	if err = file.Sync(); err != nil {
+		return "", err
+	}
+	if err = file.Close(); err != nil {
+		return "", err
+	}
+	if err = os.Rename(file.Name(), path); err != nil {
+		return "", err
+	}
+	return path, nil
+}
+
+func helperMatches(path string, payload []byte) (bool, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err == unix.ENOENT || err == unix.ELOOP {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	file := os.NewFile(uintptr(fd), path)
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return false, err
+	}
+	if !info.Mode().IsRegular() {
+		return false, fmt.Errorf("system DNS helper is not a regular file")
+	}
+	if info.Sys().(*syscall.Stat_t).Uid != uint32(os.Geteuid()) || info.Size() != int64(len(payload)) {
+		return false, nil
+	}
+	content, err := io.ReadAll(io.LimitReader(file, int64(len(payload))+1))
+	if err != nil || !bytes.Equal(content, payload) {
+		return false, err
+	}
+	if info.Mode().Perm() != 0400 {
+		if err = file.Chmod(0400); err != nil {
+			return false, err
+		}
+	}
+	return true, nil
+}
diff --git a/component/systemdns/helper_test.go b/component/systemdns/helper_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6adb7bcfaf77435bd32732a71210f05316857205
--- /dev/null
+++ b/component/systemdns/helper_test.go
@@ -0,0 +1,96 @@
+//go:build android || linux
+
+package systemdns
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestHelperReuseAndReplacement(t *testing.T) {
+	home := t.TempDir()
+	payload := []byte("current embedded dex")
+	path, err := ensureHelper(home, payload)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Reuse preserves file identity/mtime, allowing ART to retain its cache.
+	oldTime := time.Unix(1234567890, 0)
+	if err := os.Chtimes(path, oldTime, oldTime); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.Stat(path)
+	if _, err = ensureHelper(home, payload); err != nil {
+		t.Fatal(err)
+	}
+	after, _ := os.Stat(path)
+	if !os.SameFile(before, after) || !after.ModTime().Equal(oldTime) || after.Mode().Perm() != 0400 {
+		t.Fatal("matching helper was rewritten or has incorrect permissions")
+	}
+	for _, stale := range [][]byte{[]byte("old version"), []byte("xurrent embedded dex"), nil} {
+		if err := os.Chmod(path, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, stale, 0600); err != nil {
+			t.Fatal(err)
+		}
+		before, _ := os.Stat(path)
+		if _, err := ensureHelper(home, payload); err != nil {
+			t.Fatal(err)
+		}
+		content, err := os.ReadFile(path)
+		after, _ := os.Stat(path)
+		if err != nil || !bytes.Equal(content, payload) || os.SameFile(before, after) || after.Mode().Perm() != 0400 {
+			t.Fatal("stale helper was not atomically replaced")
+		}
+	}
+	files, _ := os.ReadDir(home)
+	if len(files) != 1 || files[0].Name() != helperFilename {
+		t.Fatal("temporary files left behind")
+	}
+}
+
+func TestHelperDoesNotFollowSymlink(t *testing.T) {
+	home := t.TempDir()
+	target := filepath.Join(t.TempDir(), "unrelated")
+	if err := os.WriteFile(target, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(target, filepath.Join(home, helperFilename)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ensureHelper(home, []byte("embedded dex")); err != nil {
+		t.Fatal(err)
+	}
+	content, err := os.ReadFile(target)
+	if err != nil || string(content) != "keep" {
+		t.Fatal("helper update changed the symlink target")
+	}
+}
+
+func TestHelperRemovesStaleTemporaries(t *testing.T) {
+	home := t.TempDir()
+	stale := filepath.Join(home, ".system-dns-helper-stale.dex")
+	fresh := filepath.Join(home, ".system-dns-helper-fresh.dex")
+	for _, name := range []string{stale, fresh} {
+		if err := os.WriteFile(name, []byte("partial"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	oldTime := time.Now().Add(-time.Hour)
+	if err := os.Chtimes(stale, oldTime, oldTime); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ensureHelper(home, []byte("embedded dex")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(stale); !os.IsNotExist(err) {
+		t.Fatal("stale temporary helper was not removed")
+	}
+	if _, err := os.Lstat(fresh); err != nil {
+		t.Fatal("recent temporary helper was removed")
+	}
+}
diff --git a/component/systemdns/java/SystemDnsHelper.java b/component/systemdns/java/SystemDnsHelper.java
new file mode 100644
index 0000000000000000000000000000000000000000..95bfd20997665f2be98693188a48c8be879e2a9e
--- /dev/null
+++ b/component/systemdns/java/SystemDnsHelper.java
@@ -0,0 +1,230 @@
+// Copyright 2026, AsteriskMETA contributors
+// SPDX-License-Identifier: GPL-3.0
+package mihomo.systemdns;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.net.ConnectivityManager;
+import android.net.LinkProperties;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.NetworkRequest;
+import android.os.Build;
+import android.os.Handler;
+import android.os.HandlerThread;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.ParcelFileDescriptor;
+import android.os.Process;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.Inet6Address;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.atomic.AtomicReference;
+
+/** Standalone app_process entry point. No Application, Activity, JNI or DNS queries. */
+public final class SystemDnsHelper {
+    private final ConnectivityManager connectivity;
+    private final HandlerThread worker = new HandlerThread("SystemDnsNetwork");
+    private final Set<Network> lostNetworks = new HashSet<>();
+    private final Object changed = new Object();
+    private byte[] snapshot;
+    private List<Network> selectedNetworks = new ArrayList<>();
+    private long generation;
+
+    private static final class State {
+        NetworkCapabilities capabilities;
+        LinkProperties properties;
+    }
+
+    private SystemDnsHelper(Context context) {
+        connectivity = context.getSystemService(ConnectivityManager.class);
+    }
+
+    public static void main(String[] args) {
+        try {
+            if (Process.myUid() != 0 || args.length != 1) {
+                throw new IllegalArgumentException("System DNS helper requires root and an inherited socket fd");
+            }
+            int fd = Integer.parseInt(args[0]);
+            if (fd < 3) throw new IllegalArgumentException("Invalid system DNS socket fd");
+            ParcelFileDescriptor transport = ParcelFileDescriptor.adoptFd(fd);
+            Looper.prepareMainLooper();
+            SystemDnsHelper helper = new SystemDnsHelper(systemContext());
+            // stdin is the inherited socketpair endpoint. Closing the core's
+            // endpoint ends this observer without an app lifecycle callback.
+            Thread parent = new Thread(() -> {
+                try { while (System.in.read() != -1) { } } catch (IOException ignored) { }
+                System.exit(0);
+            }, "SystemDnsParent");
+            parent.setDaemon(true);
+            parent.start();
+            try (ParcelFileDescriptor owned = transport) {
+                helper.run(new FileOutputStream(owned.getFileDescriptor()));
+            }
+        } catch (Throwable error) {
+            error.printStackTrace(System.err);
+            System.exit(1);
+        }
+    }
+
+    // app_process has no app Context. This intentional root-only bootstrap and
+    // the death link below are the only hidden-API boundaries; public SDK calls
+    // handle Connectivity Binder.
+    @SuppressLint("PrivateApi")
+    private static Context systemContext() throws ReflectiveOperationException {
+        Class<?> activityThread = Class.forName("android.app.ActivityThread");
+        Object thread = activityThread.getMethod("systemMain").invoke(null);
+        return (Context) activityThread.getMethod("getSystemContext").invoke(thread);
+    }
+
+    // Callbacks live in system_server. After it restarts this process would keep
+    // running without them and the core would retain stale DNS, so treat the
+    // service's death like any other helper failure.
+    @SuppressLint("PrivateApi")
+    private static void exitWithConnectivityService() throws Exception {
+        IBinder service = (IBinder) Class.forName("android.os.ServiceManager")
+                .getMethod("getService", String.class).invoke(null, Context.CONNECTIVITY_SERVICE);
+        if (service == null) throw new IllegalStateException("Connectivity service unavailable");
+        service.linkToDeath(() -> {
+            System.err.println("Connectivity service died; system DNS helper exiting");
+            System.exit(1);
+        }, 0);
+    }
+
+    private void run(OutputStream output) throws Exception {
+        exitWithConnectivityService();
+        worker.start();
+        Handler handler = new Handler(worker.getLooper());
+        ConnectivityManager.NetworkCallback callback = new ConnectivityManager.NetworkCallback() {
+            @Override public void onAvailable(Network network) { lostNetworks.remove(network); publish(); }
+            @Override public void onCapabilitiesChanged(Network network, NetworkCapabilities caps) {
+                publish();
+            }
+            @Override public void onLinkPropertiesChanged(Network network, LinkProperties properties) {
+                publish();
+            }
+            @Override public void onLost(Network network) { lostNetworks.add(network); publish(); }
+        };
+        NetworkRequest.Builder builder = new NetworkRequest.Builder();
+        if (Build.VERSION.SDK_INT >= 30) {
+            builder.clearCapabilities();
+        } else {
+            builder.removeCapability(NetworkCapabilities.NET_CAPABILITY_TRUSTED)
+                    .removeCapability(NetworkCapabilities.NET_CAPABILITY_NOT_RESTRICTED);
+        }
+        NetworkRequest request = builder
+                .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                .addCapability(NetworkCapabilities.NET_CAPABILITY_NOT_VPN).build();
+        connectivity.registerNetworkCallback(request, callback, handler);
+        connectivity.registerDefaultNetworkCallback(new ConnectivityManager.NetworkCallback() {
+            @Override public void onAvailable(Network network) { publish(); }
+            @Override public void onLost(Network network) { publish(); }
+            @Override public void onCapabilitiesChanged(Network network, NetworkCapabilities caps) { publish(); }
+        }, handler);
+        CountDownLatch initialized = new CountDownLatch(1);
+        AtomicReference<Throwable> failure = new AtomicReference<>();
+        handler.post(() -> {
+            try {
+                publish();
+            } catch (Throwable error) { failure.set(error); }
+            finally { initialized.countDown(); }
+        });
+        initialized.await();
+        if (failure.get() != null) throw new IllegalStateException("Cannot read network DNS", failure.get());
+        System.out.print("READY 1\n");
+        System.out.flush();
+        // The owning core drains this socketpair. Callbacks only replace the
+        // latest immutable frame; no DNS query passes through Android.
+        serve(output, -1);
+    }
+
+    private void publish() {
+        try {
+            Network active = connectivity.getActiveNetwork();
+            // Callbacks are invalidations, not a second source of truth. A network
+            // found at startup may be lingering/background and never have matched
+            // the callback request, so retaining its cached LP can miss its loss.
+            List<Network> current = Arrays.asList(connectivity.getAllNetworks());
+            lostNetworks.retainAll(current);
+            Map<Network, State> networks = new HashMap<>();
+            List<Network> eligible = new ArrayList<>();
+            for (Network network : current) {
+                if (lostNetworks.contains(network)) continue;
+                State state = new State();
+                state.capabilities = connectivity.getNetworkCapabilities(network);
+                state.properties = connectivity.getLinkProperties(network);
+                networks.put(network, state);
+                if (state.capabilities != null && state.properties != null
+                        && state.capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
+                        && state.capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_VPN)
+                        && !state.properties.getDnsServers().isEmpty()) eligible.add(network);
+            }
+            eligible.sort((a, b) -> Long.compare(a.getNetworkHandle(), b.getNetworkHandle()));
+            boolean hasActive = eligible.contains(active);
+            boolean hasValidated = false;
+            for (Network network : eligible) {
+                hasValidated |= networks.get(network).capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED);
+            }
+            LinkedHashSet<String> servers = new LinkedHashSet<>();
+            List<Network> selected = new ArrayList<>();
+            for (Network network : eligible) {
+                State state = networks.get(network);
+                if (hasActive ? !network.equals(active) : hasValidated
+                        && !state.capabilities.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)) continue;
+                selected.add(network);
+                for (InetAddress address : state.properties.getDnsServers()) {
+                    if (address.isAnyLocalAddress() || address.isLoopbackAddress() || address.isMulticastAddress()) continue;
+                    // Preserve Android's scope ID for link-local IPv6 servers.
+                    String host = address.getHostAddress();
+                    servers.add(address instanceof Inet6Address ? "[" + host + "]:53" : host + ":53");
+                    if (servers.size() == 32) break;
+                }
+                if (servers.size() == 32) break;
+            }
+            byte[] next = (new JSONObject().put("version", 1)
+                    .put("servers", new JSONArray(servers)).toString() + "\n").getBytes(StandardCharsets.UTF_8);
+            synchronized (changed) {
+                // Different links can advertise the same DNS endpoints.
+                if (!Arrays.equals(snapshot, next) || !selectedNetworks.equals(selected)) {
+                    snapshot = next;
+                    selectedNetworks = selected;
+                    generation++;
+                    changed.notifyAll();
+                }
+            }
+        } catch (Throwable error) {
+            // Do not leave the core using stale DNS after a failed callback.
+            error.printStackTrace(System.err);
+            System.exit(1);
+        }
+    }
+
+    private void serve(OutputStream output, long sent) throws IOException, InterruptedException {
+        for (;;) {
+            byte[] next;
+            synchronized (changed) {
+                while (sent == generation) changed.wait();
+                next = snapshot;
+                sent = generation;
+            }
+            output.write(next);
+            output.flush();
+        }
+    }
+}
diff --git a/component/systemdns/protocol.go b/component/systemdns/protocol.go
new file mode 100644
index 0000000000000000000000000000000000000000..eacb29b732527c12d13b24e983085ec339be7949
--- /dev/null
+++ b/component/systemdns/protocol.go
@@ -0,0 +1,46 @@
+// Package systemdns consumes DNS configuration, never Android DNS queries.
+package systemdns
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/netip"
+)
+
+const MaxFrame = 8192
+
+func decodeSnapshot(frame []byte) ([]string, error) {
+	if len(frame) > MaxFrame {
+		return nil, fmt.Errorf("system DNS snapshot exceeds frame limit")
+	}
+	var snapshot struct {
+		Version int      `json:"version"`
+		Servers []string `json:"servers"`
+	}
+	decoder := json.NewDecoder(bytes.NewReader(frame))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&snapshot); err != nil {
+		return nil, err
+	}
+	if decoder.Decode(new(any)) != io.EOF || snapshot.Version != 1 || snapshot.Servers == nil || len(snapshot.Servers) > 32 {
+		return nil, fmt.Errorf("invalid system DNS snapshot")
+	}
+	seen := make(map[string]bool)
+	servers := make([]string, 0, len(snapshot.Servers))
+	for _, server := range snapshot.Servers {
+		endpoint, err := netip.ParseAddrPort(server)
+		address := endpoint.Addr().Unmap()
+		if err != nil || endpoint.Port() != 53 || address.IsUnspecified() ||
+			address.IsLoopback() || address.IsMulticast() {
+			return nil, fmt.Errorf("invalid system DNS endpoint")
+		}
+		server = endpoint.String()
+		if !seen[server] {
+			seen[server] = true
+			servers = append(servers, server)
+		}
+	}
+	return servers, nil
+}
